    {
      "leafId": "control-codex-sessions",
      "title": "Control Codex Sessions",
      "description": "Coordinate a complete user-visible Codex task run by sequencing the control-plane ledger MCP with native task tools executed only by the active Codex host.",
      "executionClass": "host_coordinator",
      "runtimeBinding": {
        "kind": "host_coordinator",
        "instruction": "At the active Codex host, apply the public control-codex-sessions contract to this structured request. Use codex_session_control_plane only for durable ledger state and prepared/imported intents; execute every returned native codex_app task call in the host under current user authority, then record the actual result. Never claim the MCP server executed a native task tool. Return the complete controller handoff required by the output schema."
      },
      "authorityRequests": [
        {
          "authority": "codex-visible-task-read",
          "reason": "Resolve projects and read/list/wait for the exact user-visible Codex tasks in the declared run."
        },
        {
          "authority": "codex-visible-task-mutate",
          "reason": "Create, message, fork, hand off, title, pin, archive, or navigate tasks only when the current request explicitly authorizes the corresponding live action."
        },
        {
          "authority": "control-plane-ledger-read-write",
          "reason": "Create, read, and update the declared run's durable control-plane state through its MCP leaves."
        },
        {
          "authority": "loopback-network-listen",
          "reason": "Start the optional dashboard only when startDashboard is requested."
        }
      ],
      "artifactRoots": [],
      "inputSchema": {
        "schemaVersion": "local-capability-schema/v1",
        "schemaId": "codex-thread-orchestration/control-codex-sessions-input/v1",
        "path": "schemas/local-capability/coordinator/control-codex-sessions-input.schema.json"
      },
      "outputSchema": {
        "schemaVersion": "local-capability-schema/v1",
        "schemaId": "codex-thread-orchestration/control-codex-sessions-output/v1",
        "path": "schemas/local-capability/coordinator/control-codex-sessions-output.schema.json"
      },
      "inputPorts": [],
      "outputPorts": []
    }
