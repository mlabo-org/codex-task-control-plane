      "executionClass": "server_deterministic",
      "runtimeBinding": {
        "kind": "mcp_tool",
        "mcpServer": "codex_session_control_plane",
        "tool": "control_plane_preflight"
      },
      "authorityRequests": [
        {
          "authority": "local-filesystem-read",
          "reason": "Read metadata for the caller-supplied project directory during validation."
        }
      ],
      "artifactRoots": [],
      "inputSchema": {
        "schemaVersion": "local-capability-schema/v1",
        "schemaId": "codex-thread-orchestration/mcp/control-plane-preflight-input/v1",
        "path": "schemas/local-capability/mcp/control-plane-preflight.input.schema.json"
      },
      "outputSchema": {
        "schemaVersion": "local-capability-schema/v1",
        "schemaId": "codex-thread-orchestration/mcp/control-plane-preflight-output/v1",
        "path": "schemas/local-capability/mcp/control-plane-preflight.output.schema.json"
      },
      "inputPorts": [],
      "outputPorts": []
    },
