      "leafId": "control-plane-dashboard-start",
      "title": "Start Control Plane Dashboard",
      "description": "Start or reuse the loopback-only bilingual ledger-and-intent dashboard and return its local URL.",
      "executionClass": "server_stateful",
      "runtimeBinding": {
        "kind": "mcp_tool",
        "mcpServer": "codex_session_control_plane",
        "tool": "control_plane_dashboard_start"
      },
      "authorityRequests": [
        {
          "authority": "loopback-network-listen",
          "reason": "Bind the dashboard HTTP server only to localhost or an operating-system loopback address."
        },
        {
          "authority": "control-plane-ledger-read-write",
          "reason": "Serve ledger snapshots and token-guarded intent actions through the local dashboard."
        }
      ],
      "artifactRoots": [],
