{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mlabo-org/codex-task-control-plane/schemas/run.schema.json",
  "title": "Codex Task Control Plane Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "status",
    "executionMode",
    "controller",
    "tasks",
    "threads",
    "operations",
    "messages",
    "events",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^run_" },
    "objective": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["active", "review", "settling", "completed", "failed", "cancelled"]
    },
    "executionMode": { "type": "string", "enum": ["dry-run", "live"] },
    "maxRoundTrips": { "type": "integer", "minimum": 1, "maximum": 64 },
    "controller": { "$ref": "#/$defs/address" },
    "tasks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/task" }
    },
    "threads": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/thread" }
    },
    "operations": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/operation" }
    },
    "messages": {
      "type": "array",
      "items": { "$ref": "./message.schema.json" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "address": {
      "type": "object",
      "required": ["threadId", "hostId"],
      "properties": {
        "role": { "type": "string" },
        "threadId": { "$ref": "#/$defs/nullableString" },
        "hostId": { "$ref": "#/$defs/nullableString" }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "prompt",
        "role",
        "cwd",
        "status",
        "target",
        "profile",
        "workflow",
        "acceptanceCriteria",
        "roundTrips",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^task_" },
        "title": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "prepared",
            "provisioning",
            "running",
            "idle",
            "blocked",
            "needs_attention",
            "review",
            "settling",
            "failed",
            "cancel_requested",
            "completed",
            "cancelled"
          ]
        },
        "threadTitle": { "$ref": "#/$defs/nullableString" },
        "threadId": { "$ref": "#/$defs/nullableString" },
        "hostId": { "$ref": "#/$defs/nullableString" },
        "clientThreadId": { "$ref": "#/$defs/nullableString" },
        "sourceTaskId": { "$ref": "#/$defs/nullableString" },
        "project": { "type": ["object", "null"] },
        "target": {
          "type": "object",
          "required": ["environment", "accessMode"],
          "properties": {
            "environment": { "enum": ["local", "worktree"] },
            "accessMode": { "enum": ["read", "write"] },
            "integrationTargetBranch": { "$ref": "#/$defs/nullableString" },
            "worktreePurpose": { "$ref": "#/$defs/nullableString" },
            "worktreeLifecycleAuthority": { "$ref": "#/$defs/nullableString" },
            "startingState": { "type": ["object", "null"] }
          }
        },
        "profile": { "type": "object" },
        "workflow": { "type": "object" },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
        "roundTrips": { "type": "integer", "minimum": 0 },
        "lastCursor": { "$ref": "#/$defs/nullableString" },
        "result": { "type": ["object", "null"] },
        "error": { "type": ["object", "null"] },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "type": "string" } },
        "git": { "type": "object" },
        "worktree": { "type": "object" },
        "settlement": { "$ref": "#/$defs/settlement" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "thread": {
      "type": "object",
      "required": ["taskId", "status", "pinned", "archived", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nullableString" },
        "hostId": { "$ref": "#/$defs/nullableString" },
        "clientThreadId": { "$ref": "#/$defs/nullableString" },
        "taskId": { "type": "string" },
        "sourceTaskId": { "$ref": "#/$defs/nullableString" },
        "title": { "$ref": "#/$defs/nullableString" },
        "project": { "type": ["object", "null"] },
        "runtimeCwd": { "$ref": "#/$defs/nullableString" },
        "status": {
          "type": "string",
          "enum": ["provisioning", "active", "idle", "blocked", "needs_attention", "handoff", "completed", "failed", "archived"]
        },
        "previousStatus": { "$ref": "#/$defs/nullableString" },
        "pinned": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "settlement": {
      "type": "object",
      "required": ["required", "decision", "phase", "terminalStatus", "operationIds"],
      "properties": {
        "required": { "type": "boolean" },
        "decision": { "enum": ["adopt", "continue", "discard", null] },
        "phase": { "type": "string" },
        "terminalStatus": { "$ref": "#/$defs/nullableString" },
        "operationIds": { "type": "array", "items": { "type": "string" } },
        "adoptionReceipt": { "type": ["object", "null"] },
        "cleanupReceipt": { "type": ["object", "null"] },
        "blocker": { "type": ["object", "null"] }
      }
    },
    "operation": {
      "type": "object",
      "required": ["id", "kind", "tool", "status", "phase", "taskIds", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^op_" },
        "kind": { "type": "string", "enum": ["dispatch", "native"] },
        "tool": { "type": "string", "pattern": "^codex_app__" },
        "status": { "type": "string", "enum": ["prepared", "pending", "succeeded", "failed"] },
        "phase": { "type": "string", "enum": ["project_lookup", "ready"] },
        "taskIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "arguments": { "type": ["object", "null"] },
        "metadata": { "type": "object" },
        "result": { "type": ["object", "null"] },
        "error": { "type": ["object", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "summary", "details", "at"],
      "properties": {
        "id": { "type": "string", "pattern": "^evt_" },
        "type": { "type": "string" },
        "summary": { "type": "string" },
        "details": { "type": "object" },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
