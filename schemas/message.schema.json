{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mlabo-org/codex-thread-orchestration/schemas/message.schema.json",
  "title": "Codex Thread Orchestration Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "runId",
    "type",
    "createdAt",
    "sender",
    "recipient",
    "payload",
    "metadata",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "codex-thread-message/v2" },
    "id": { "type": "string", "pattern": "^msg_" },
    "runId": { "type": "string", "pattern": "^run_" },
    "type": {
      "type": "string",
      "enum": ["ASSIGN", "QUESTION", "PROPOSAL", "STATUS", "REVIEW", "RESULT", "DECISION", "CANCEL", "FORK"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "sender": { "$ref": "#/$defs/address" },
    "recipient": { "$ref": "#/$defs/address" },
    "payload": { "type": "string" },
    "metadata": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": ["artifacts", "verification"],
      "properties": {
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "taskId", "threadId", "hostId"],
      "properties": {
        "role": { "type": "string" },
        "taskId": { "type": ["string", "null"] },
        "threadId": { "type": ["string", "null"] },
        "hostId": { "type": ["string", "null"] }
      }
    }
  }
}
