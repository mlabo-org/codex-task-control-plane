{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-task-control-plane/mcp/control-plane-create-run-output/v1",
  "title": "control_plane_create_run output",
  "$ref": "#/$defs/run",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "type",
        "summary",
        "details",
        "at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "$ref": "#/$defs/text"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "at": {
          "$ref": "#/$defs/time"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "objective",
        "status",
        "executionMode",
        "createdAt",
        "updatedAt",
        "maxRoundTrips",
        "controller",
        "tasks",
        "threads",
        "operations",
        "messages",
        "events"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "objective": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "active",
            "review",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "executionMode": {
          "enum": [
            "dry-run",
            "live"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/time"
        },
        "updatedAt": {
          "$ref": "#/$defs/time"
        },
        "maxRoundTrips": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "controller": {
          "type": "object",
          "required": [
            "role",
            "threadId",
            "hostId"
          ],
          "properties": {
            "role": {
              "const": "controller"
            },
            "threadId": {
              "type": [
                "string",
                "null"
              ]
            },
            "hostId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "threads": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
