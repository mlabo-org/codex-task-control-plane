{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-task-control-plane/mcp/control-plane-decide-input/v1",
  "title": "control_plane_decide input",
  "type": "object",
  "required": [
    "runId",
    "taskId",
    "decision"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "adopt",
        "continue",
        "discard"
      ]
    },
    "note": {
      "type": "string",
      "default": ""
    }
  },
  "additionalProperties": false
}
