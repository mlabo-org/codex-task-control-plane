{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-task-control-plane/mcp/control-plane-complete-operation-output/v1",
  "title": "control_plane_complete_operation output",
  "oneOf": [
    {
      "$ref": "#/$defs/completion"
    },
    {
      "$ref": "#/$defs/failedOperation"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "tool",
        "status",
        "phase",
        "taskIds",
        "childTaskId",
        "arguments",
        "metadata",
        "project",
        "confirmedAt",
        "runtimeOperationId",
        "runtimeRevision",
        "result",
        "error",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "dispatch",
            "native"
          ]
        },
        "tool": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "pending"
          ]
        },
        "phase": {
          "enum": [
            "project_lookup",
            "ready"
          ]
        },
        "taskIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "childTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "arguments": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "project": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "confirmedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "runtimeOperationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtimeRevision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "result": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "error": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "status",
        "threadId",
        "hostId",
        "clientThreadId",
        "lastCursor",
        "result",
        "error",
        "artifacts",
        "verification"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "created",
            "prepared",
            "provisioning",
            "running",
            "idle",
            "blocked",
            "needs_attention",
            "review",
            "failed",
            "cancel_requested",
            "completed",
            "cancelled"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "error": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "additionalProperties": true
    },
    "completion": {
      "type": "object",
      "required": [
        "operation",
        "tasks"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      },
      "additionalProperties": false
    },
    "failedOperation": {
      "$ref": "#/$defs/operation"
    }
  }
}
