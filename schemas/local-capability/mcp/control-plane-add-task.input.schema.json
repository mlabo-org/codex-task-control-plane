{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-task-control-plane/mcp/control-plane-add-task-input/v1",
  "title": "control_plane_add_task input",
  "type": "object",
  "required": [
    "runId",
    "title",
    "prompt",
    "role",
    "cwd"
  ],
  "properties": {
    "runId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "prompt": {
      "$ref": "#/$defs/text"
    },
    "role": {
      "$ref": "#/$defs/text"
    },
    "cwd": {
      "$ref": "#/$defs/text"
    },
    "accessMode": {
      "enum": ["read", "write"],
      "default": "write"
    },
    "environment": {
      "enum": [
        "local",
        "worktree"
      ],
      "default": "local"
    },
    "integrationTargetBranch": {
      "$ref": "#/$defs/text"
    },
    "worktreePurpose": {
      "enum": [
        "same_repo_parallel_write",
        "destructive_experiment",
        "explicit_user_isolation"
      ]
    },
    "worktreeLifecycleAuthority": {
      "$ref": "#/$defs/text"
    },
    "startingState": {
      "$ref": "#/$defs/startingState"
    },
    "model": {
      "$ref": "#/$defs/text"
    },
    "thinking": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "profileAuthority": {
      "$ref": "#/$defs/text"
    },
    "stateControl": {
      "enum": [
        "none",
        "codex-activity-oversight"
      ],
      "default": "none"
    },
    "stateControlScope": {
      "$ref": "#/$defs/text"
    },
    "deliveryMode": {
      "enum": [
        "ITERATIVE_DELIVERY",
        "ONE_SHOT_QUALITY"
      ],
      "default": "ITERATIVE_DELIVERY"
    },
    "deliveryModeAuthority": {
      "$ref": "#/$defs/text"
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "default": []
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "startingState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "working-tree"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "branchName"
          ],
          "properties": {
            "type": {
              "const": "branch"
            },
            "branchName": {
              "$ref": "#/$defs/text"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
