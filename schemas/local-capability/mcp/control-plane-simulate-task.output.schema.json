{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-thread-orchestration/mcp/control-plane-simulate-task-output/v1",
  "title": "control_plane_simulate_task output",
  "type": "object",
  "required": ["id", "title", "prompt", "role", "cwd", "status", "threadTitle", "threadId", "hostId", "clientThreadId", "sourceTaskId", "project", "target", "profile", "workflow", "acceptanceCriteria", "createdAt", "updatedAt", "roundTrips", "lastCursor", "result", "error", "artifacts", "verification"],
  "properties": {
    "id": { "$ref": "#/$defs/text" }, "title": { "$ref": "#/$defs/text" }, "prompt": { "$ref": "#/$defs/text" }, "role": { "$ref": "#/$defs/text" }, "cwd": { "$ref": "#/$defs/text" },
    "status": { "const": "review" }, "threadTitle": { "type": ["string", "null"] }, "threadId": { "type": "null" }, "hostId": { "type": "null" }, "clientThreadId": { "type": "null" }, "sourceTaskId": { "type": ["string", "null"] },
    "project": { "$ref": "#/$defs/project" }, "target": { "$ref": "#/$defs/target" }, "profile": { "$ref": "#/$defs/profile" }, "workflow": { "$ref": "#/$defs/workflow" },
    "acceptanceCriteria": { "$ref": "#/$defs/textArray" }, "createdAt": { "$ref": "#/$defs/time" }, "updatedAt": { "$ref": "#/$defs/time" }, "roundTrips": { "const": 0 }, "lastCursor": { "type": "null" }, "result": { "type": "object", "required": ["summary", "simulated"], "properties": { "summary": { "$ref": "#/$defs/text" }, "simulated": { "const": true } }, "additionalProperties": false }, "error": { "type": "null" }, "artifacts": { "$ref": "#/$defs/textArray" }, "verification": { "$ref": "#/$defs/textArray" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 }, "time": { "type": "string", "format": "date-time" }, "textArray": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "project": { "type": ["object", "null"], "required": ["projectId", "projectKind", "label", "path", "hostId", "isGitRepository", "environment"], "properties": { "projectId": { "$ref": "#/$defs/text" }, "projectKind": { "type": ["string", "null"] }, "label": { "type": ["string", "null"] }, "path": { "$ref": "#/$defs/text" }, "hostId": { "type": ["string", "null"] }, "isGitRepository": { "type": "boolean" }, "environment": { "enum": ["local", "worktree"] } }, "additionalProperties": false },
    "startingState": { "oneOf": [ { "type": "null" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "working-tree" } }, "additionalProperties": false }, { "type": "object", "required": ["type", "branchName"], "properties": { "type": { "const": "branch" }, "branchName": { "$ref": "#/$defs/text" } }, "additionalProperties": false } ] },
    "target": { "type": "object", "required": ["environment", "startingState"], "properties": { "environment": { "enum": ["auto", "local", "worktree"] }, "startingState": { "$ref": "#/$defs/startingState" } }, "additionalProperties": false },
    "profile": { "type": "object", "required": ["model", "thinking", "authority"], "properties": { "model": { "type": ["string", "null"] }, "thinking": { "type": ["string", "null"] }, "authority": { "type": ["string", "null"] } }, "additionalProperties": false },
    "workflow": { "type": "object", "required": ["mode", "codingAgentsScope", "deliveryMode", "deliveryModeAuthority", "maxDelegationDepth", "delegationAuthority"], "properties": { "mode": { "enum": ["direct", "coding-agents"] }, "codingAgentsScope": { "type": ["string", "null"] }, "deliveryMode": { "enum": ["ITERATIVE_DELIVERY", "ONE_SHOT_QUALITY"] }, "deliveryModeAuthority": { "type": ["string", "null"] }, "maxDelegationDepth": { "type": "integer", "minimum": 0, "maximum": 8 }, "delegationAuthority": { "type": ["string", "null"] } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
