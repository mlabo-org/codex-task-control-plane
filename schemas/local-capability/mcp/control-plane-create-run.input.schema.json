{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-thread-orchestration/mcp/control-plane-create-run-input/v1",
  "title": "control_plane_create_run input",
  "type": "object",
  "required": ["objective"],
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "controllerThreadId": { "type": ["string", "null"], "minLength": 1 },
    "controllerHostId": { "type": ["string", "null"], "minLength": 1 },
    "executionMode": { "enum": ["dry-run", "live"], "default": "dry-run" },
    "maxRoundTrips": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8 }
  },
  "additionalProperties": false
}
