{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-task-control-plane/control-codex-tasks-output/v1",
  "title": "Control Codex Tasks coordinator output",
  "description": "The complete controller handoff for a user-visible Codex task-control run.",
  "type": "object",
  "required": [
    "runId",
    "runStatus",
    "executionMode",
    "tasks",
    "nativeCalls",
    "controllerDecisions",
    "artifacts",
    "verification",
    "blockers",
    "unknowns",
    "unfinishedScope",
    "userAttentionRequired"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "runStatus": {
      "type": "string",
      "enum": [
        "active",
        "review",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "dry-run",
        "live"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskResult"
      }
    },
    "nativeCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "status"
        ],
        "properties": {
          "operationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "prepared",
              "pending",
              "succeeded",
              "failed",
              "not-executed"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "controllerDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "decision"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "adopt",
              "continue",
              "discard"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dashboardUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\]|localhost):[0-9]+/"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unfinishedScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "userAttentionRequired": {
      "type": "boolean"
    }
  },
  "$defs": {
    "taskResult": {
      "type": "object",
      "required": [
        "taskId",
        "title",
        "role",
        "status",
        "threadId",
        "clientThreadId",
        "hostId",
        "toolsCalled",
        "artifacts",
        "verification",
        "blockers",
        "unknowns"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "prepared",
            "provisioning",
            "running",
            "idle",
            "review",
            "blocked",
            "needs_attention",
            "failed",
            "cancel_requested",
            "completed",
            "cancelled"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolsCalled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "controllerDecision": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "adopt",
            "continue",
            "discard",
            null
          ]
        },
        "resultSummary": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
